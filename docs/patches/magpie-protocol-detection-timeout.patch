+// A reasoning relay may take longer than the ordinary endpoint test deadline.
+func TestDetectWaitsForReasoningRelay(t *testing.T) {
+	detectHome(t)
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/v1/chat/completions" && r.URL.Path != "/v1/messages" {
+			http.NotFound(w, r)
+			return
+		}
+		timer := time.NewTimer(30 * time.Second)
+		defer timer.Stop()
+		select {
+		case <-timer.C:
+		case <-r.Context().Done():
+			return
+		}
+		if r.URL.Path == "/v1/messages" {
+			io.WriteString(w, `{"id":"m","type":"message","role":"assistant","content":[{"type":"text","text":"OK"}],"stop_reason":"max_tokens"}`)
+		} else {
+			io.WriteString(w, `{"id":"c","object":"chat.completion","choices":[{"index":0,"message":{"role":"assistant","content":"OK"},"finish_reason":"length"}]}`)
+		}
+	}))
+	defer srv.Close()
+	p := Provider{Key: "test-key"}
+	for _, batch := range []bool{false, true} {
+		t.Run(map[bool]string{false: "single", true: "batch"}[batch], func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), DetectTimeout(1))
+			defer cancel()
+			var results []Detection
+			var err error
+			if batch {
+				_, results, err = p.DetectModels(ctx, srv.URL, []string{"gpt-reasoning"})
+			} else {
+				results, err = p.Detect(ctx, srv.URL, "gpt-reasoning")
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, result := range results {
+				if (result.Protocol == Chat || result.Protocol == Anthropic) && !result.OK {
+					t.Errorf("slow %s endpoint was rejected: %+v", result.Protocol, result)
+				}
+			}
+		})
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	results, err := p.Detect(ctx, srv.URL, "gpt-reasoning")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, result := range results {
+		if result.OK {
+			t.Errorf("cancelled probe succeeded: %+v", result)
+		}
+	}
+}
