+// The editor must not cancel detection before the longer provider probe ends.
+func TestProviderDetectWithSlowRelay(t *testing.T) {
+	t.Setenv("HOME", t.TempDir())
+	t.Setenv("USERPROFILE", os.Getenv("HOME"))
+	t.Setenv("XDG_CONFIG_HOME", t.TempDir())
+	t.Setenv("XDG_CACHE_HOME", t.TempDir())
+	up := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		io.Copy(io.Discard, r.Body)
+		if r.URL.Path != "/v1/chat/completions" && r.URL.Path != "/v1/messages" {
+			http.NotFound(w, r)
+			return
+		}
+		timer := time.NewTimer(30 * time.Second)
+		defer timer.Stop()
+		select {
+		case <-timer.C:
+		case <-r.Context().Done():
+			return
+		}
+		if r.URL.Path == "/v1/messages" {
+			io.WriteString(w, `{"type":"message","content":[{"type":"text","text":"OK"}]}`)
+		} else {
+			io.WriteString(w, `{"choices":[{"message":{"content":"OK"}}]}`)
+		}
+	}))
+	defer up.Close()
+	mux := http.NewServeMux()
+	providerRoutes(mux, nil)
+	body, _ := json.Marshal(map[string]any{"typed": true, "key": "test-key", "base": up.URL, "model": "gpt-reasoning"})
+	w := httptest.NewRecorder()
+	mux.ServeHTTP(w, httptest.NewRequest("POST", "/api/provider/detect", strings.NewReader(string(body))))
+	if w.Code != 200 {
+		t.Fatalf("%d %s", w.Code, w.Body.String())
+	}
+	var got struct{ Results []provider.Detection }
+	if err := json.Unmarshal(w.Body.Bytes(), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got.Results) != 4 {
+		t.Fatalf("missing detections: %s", w.Body.String())
+	}
+	for _, result := range got.Results {
+		if (result.Protocol == provider.Chat || result.Protocol == provider.Anthropic) && !result.OK {
+			t.Errorf("editor cancelled slow %s: %+v", result.Protocol, result)
+		}
+	}
+}
