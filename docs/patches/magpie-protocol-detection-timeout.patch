+// DetectTimeout lets every queued protocol probe finish, with time for model
+// discovery and writing the result. A single detection asks its APIs in parallel.
+func DetectTimeout(models int) time.Duration {
+	models = min(max(models, 1), DetectMax)
+	waves := (models*len(detectProtocols) + DetectWide - 1) / DetectWide
+	return time.Duration(waves)*detectWait + 15*time.Second
+}
